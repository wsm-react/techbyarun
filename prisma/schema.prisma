// Prisma ORM v7 — MySQL/MariaDB schema (driver adapter: @prisma/adapter-mariadb)
// Reference: https://www.prisma.io/docs/orm/v7/core-concepts/supported-databases/mysql

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String     @id @default(cuid())
  name      String?
  email     String     @unique
  password  String
  mobile    String?
  role      String     @default("user")
  posts     BlogPost[]
  leads     Leads[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model BlogPost {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  subTitle  String?   @map("sub_title")
  tag       String?
  body      String    @db.LongText
  published Boolean
  authorId  String    @map("author_id")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]

  @@index([authorId])
  @@map("blog_posts")
}

model Leads {
  id        String   @id @default(cuid())
  email     String
  name      String?
  mobile    String
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")
  loginTime DateTime @default(now()) @map("login_time")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("leads")
}

model Comment {
  id      String   @id @default(cuid())
  comment String   @db.Text
  postId  String   @map("post_id")
  post    BlogPost @relation(fields: [postId], references: [id])

  @@index([postId])
  @@map("comments")
}

model ContactUs {
  id         String    @id @default(cuid())
  firstName  String    @map("first_name")
  lastName   String?   @map("last_name")
  phone      String
  email      String    @unique
  subject    String?
  message    String?   @db.Text
  lookingFor String?   @map("looking_for")
  budget     String?
  dueDate    DateTime? @map("due_date")
  address    Json?
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("contact_us")
}

model Jobs {
  id                    String                 @id @default(cuid())
  uuid                  String                 @unique
  slug                  String                 @unique
  employeeTypes         Json                   @map("employee_types")
  employmentCategories  Json                   @map("employment_categories")
  status                String
  jobTitles             JobTitle[]
  educationRequirements EducationRequirement[]
  jobClassification     JobClassification?
  jobDescriptions       JobDescription[]
  skills                JobSkill[]
  workLocations         JobWorkLocation[]
  updatedAt             DateTime               @updatedAt @map("updated_at")
  createdAt             DateTime               @default(now()) @map("created_at")

  @@map("jobs")
}

model JobTitle {
  id          String @id @default(cuid())
  uuid        String @unique
  title       String
  description String @db.Text
  jobId       String @map("job_id")
  job         Jobs   @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("job_titles")
}

model Skill {
  id              String     @id @default(cuid())
  uuid            String     @unique
  context         String
  displayName     String     @map("display_name")
  experienceYears Int        @map("experience_years")
  importance      String
  isValidated     Boolean    @map("is_validated")
  level           String
  type            String
  jobs            JobSkill[]

  @@map("skills")
}

model WorkLocation {
  id        String            @id @default(cuid())
  uuid      String            @unique
  isCurrent Boolean           @map("is_current")
  priority  Int
  address   Json
  jobs      JobWorkLocation[]

  @@map("work_locations")
}

model EducationRequirement {
  id          String   @id @default(cuid())
  uuid        String   @unique
  degreeTypes Json     @map("degree_types")
  importance  String
  jobId       String   @map("job_id")
  job         Jobs     @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("education_requirements")
}

model JobClassification {
  id          String @id @default(cuid())
  uuid        String @unique
  category    String
  department  String
  environment String
  industry    String
  subcategory String @map("sub_category")
  jobId       String @unique @map("job_id")
  job         Jobs   @relation(fields: [jobId], references: [id])

  @@map("job_classifications")
}

model JobDescription {
  id               String    @id @default(cuid())
  uuid             String    @unique
  benefits         Benefit[]
  description      String    @db.LongText
  qualifications   String    @db.LongText
  responsibilities String    @db.LongText
  type             String
  jobId            String    @map("job_id")
  job              Jobs      @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("job_descriptions")
}

model Benefit {
  id               String         @id @default(cuid())
  uuid             String         @unique
  context          String
  type             String
  jobDescriptionId String         @map("job_description_id")
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id])

  @@index([jobDescriptionId])
  @@map("benefits")
}

model JobSkill {
  id      String @id @default(cuid())
  uuid    String @unique
  jobId   String @map("job_id")
  skillId String @map("skill_id")
  job     Jobs   @relation(fields: [jobId], references: [id])
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@unique([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

model JobWorkLocation {
  id             String       @id @default(cuid())
  uuid           String       @unique
  jobId          String       @map("job_id")
  workLocationId String       @map("work_location_id")
  job            Jobs         @relation(fields: [jobId], references: [id])
  workLocation   WorkLocation @relation(fields: [workLocationId], references: [id])

  @@unique([jobId, workLocationId])
  @@index([workLocationId])
  @@map("job_work_locations")
}

// ---------------------------------------------------------------------------
// Admin-managed site content (CRUD via /api/v1/*, seeded from prisma/seed.ts)
// ---------------------------------------------------------------------------

model Service {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  tag               String?
  description       String?  @db.Text
  badge             String?
  heading           String?
  headingAccent     String?  @map("heading_accent")
  intro             String?  @db.Text
  // Content sections rendered on the detail page, e.g.:
  // [{ type: "paragraphs", items: ["..."] }, { type: "bullets", title: "What You Get", items: ["..."] },
  //  { type: "chips", title: "Tech Stack", items: ["..."] },
  //  { type: "steps", title: "My Process", items: [{ step, title, desc }] }]
  sections          Json?
  ctaLabel          String?  @map("cta_label")
  sortOrder         Int      @default(0) @map("sort_order")
  published         Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("services")
}

model CaseStudy {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  headingAccent      String?  @map("heading_accent")
  tag                String?
  cardTags           Json?    @map("card_tags")
  projectDescription String?  @map("project_description") @db.Text
  cardDescription    String?  @map("card_description") @db.Text
  intro              String?  @db.Text
  serviceTags        Json?    @map("service_tags")
  highlights         Json?
  sections           Json?
  ctaLabel           String?  @map("cta_label")
  sortOrder          Int      @default(0) @map("sort_order")
  published          Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("case_studies")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
