{
    "name": "techbyarun",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "devx": "next dev --experimental-https",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "clean": "yarn cache clean && rm -rf node_modules && rm -rf yarn.lock && rm -rf package-lock.json && rm -rf .vscode && rm -rf .next/cache && yarn install",
        "git": "git add . && git commit -m \"$COMMENT :: on $(date +'%a, %b %d, %Y %r')\" && git push --all --force",
        "gitpull": "git pull --all --force",
        "gitpush": "git pull --all --force",
        "build:production": "npx dotenv -e .env.local -- npm run migrate && npm run generate && npm run build",
        "prisma:postinstall": "npx prisma db push && prisma migrate dev",
        "prisma:migrate": "prisma migrate dev",
        "prisma:postmigrate": "npx @snaplet/seed sync",
        "prisma:seed": "npx prisma db seed",
        "prisma:reset": "npx prisma migrate dev -n reset",
        "prisma:init": "npx prisma init",
        "prisma:generate": "npx prisma generate",
        "prisma:push": "npx prisma db push",
        "prisma:pull": "npx prisma db pull --force",
        "prisma:studio": "npx prisma studio",
        "vercel": "vercel --prod",
        "ngrok:": "ngrok http --domain=polecat-peaceful-gradually.ngrok-free.app 3000"
    },
    "prisma": {
        "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
    },
    "dependencies": {
        "@next-auth/prisma-adapter": "^1.0.7",
        "@prisma/client": "^5.17.0",
        "@types/bcrypt": "^5.0.2",
        "@types/ejs": "^3.1.5",
        "@types/mongoose": "^5.11.97",
        "@vercel/analytics": "^1.3.1",
        "@vinejs/vine": "^2.1.0",
        "bcrypt": "^5.1.1",
        "ejs": "^3.1.10",
        "elevenlabs": "^0.14.0",
        "framer-motion": "^11.3.23",
        "lucide-react": "^0.424.0",
        "mongodb": "^6.8.0",
        "mongoose": "^8.5.2",
        "next": "14.2.5",
        "next-auth": "^4.24.7",
        "next-themes": "^0.3.0",
        "prisma": "^5.17.0",
        "react": "^18",
        "react-dom": "^18"
    },
    "devDependencies": {
        "@types/node": "^22.1.0",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "eslint": "^8",
        "eslint-config-next": "14.2.5",
        "postcss": "^8",
        "tailwindcss": "^3.4.1",
        "ts-node": "^10.9.2",
        "typescript": "^5"
    }
}
