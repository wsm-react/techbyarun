{
  "name": "techbyarun",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "devx": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "yarn cache clean && rm -rf node_modules && rm -rf yarn.lock && rm -rf package-lock.json && rm -rf .vscode && rm -rf .next/cache && yarn install",
    "git": "git add . && git commit -m \"Updated :: on $(date +'%a, %b %d, %Y %r')\" && git push --all --force",
    "gitpull": "git pull --all --force",
    "gitpush": "git pull --all --force",
    "build:production": "npx dotenv -e .env.local -- npm run prisma:generate && npm run build",
    "prebuild": "prisma contract emit",
    "prisma:postinstall": "npx prisma contract emit",
    "prisma:migrate": "npx prisma db update",
    "prisma:postmigrate": "npx @snaplet/seed sync",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "prisma:generate": "npx prisma contract emit",
    "prisma:pull": "npx prisma contract infer",
    "vercel": "vercel --prod",
    "ngrok": "ngrok http --domain=polecat-peaceful-gradually.ngrok-free.app 3000"
  },
